# 高德 Web JS API Key，用于浏览器地图展示。
VITE_AMAP_KEY=
VITE_AMAP_SERVICE_HOST=/_AMapService

# 与 Web JS Key 配套的安全密钥，仅由 Nginx 同源代理读取。
AMAP_SECURITY_JSCODE=

# 高德 Web 服务 Key，用于 Mock 道路轨迹和运维路线优化。
AMAP_WEB_SERVICE_KEY=
AMAP_DISTANCE_API_URL=https://restapi.amap.com/v3/distance
AMAP_DRIVING_API_URL=https://restapi.amap.com/v3/direction/driving

# Mock 道路轨迹参数。默认北京、上海各生成 100 辆车。
AMAP_ROUTE_API_URL=https://restapi.amap.com/v4/direction/bicycling
AMAP_ROUTE_API_KEY=
MOCK_VEHICLES_PER_CITY=100
AMAP_ROUTE_CONCURRENCY=1
AMAP_ROUTE_INTERVAL_MS=650

# Mock 环境管理员，部署前必须修改默认密码。
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=Admin123!

# 运维凭证存储目录；Compose 内固定使用具名卷，无需本机填写。
OPS_EVIDENCE_STORAGE_PATH=

# 报表 Worker 查询库。生产环境应改为只读副本。
REPORT_DB_URL=
REPORT_DB_HOST=db
REPORT_DB_PORT=5432
REPORT_DB_NAME=bike
REPORT_DB_USER=bike
REPORT_DB_PASSWORD=bike_dev_password
REPORT_STATEMENT_TIMEOUT_MS=120000
