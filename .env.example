# Docker Compose 前端构建使用的高德 Web JS Key。
VITE_AMAP_KEY=
VITE_AMAP_SERVICE_HOST=/_AMapService

# 与 Web JS Key 配套的安全密钥，仅由 Nginx 同源代理读取。
AMAP_SECURITY_JSCODE=

# 仅供 backend/scripts/generate-mock-data.mjs 调用高德 Web 服务。
AMAP_WEB_SERVICE_KEY=

# Mock 道路轨迹生成参数；默认使用高德 v4 骑行接口，北京和上海各生成 100 辆。
AMAP_ROUTE_API_URL=https://restapi.amap.com/v4/direction/bicycling
AMAP_ROUTE_API_KEY=
MOCK_VEHICLES_PER_CITY=100
AMAP_ROUTE_CONCURRENCY=1
AMAP_ROUTE_INTERVAL_MS=650
